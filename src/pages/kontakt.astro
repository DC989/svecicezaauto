---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kontakt - Svecicezaauto">
  <main class="page-content">
    <div class="content-header">
      <h1 class="page-title">Kontakt</h1>
      <p class="page-description">
        Za sve informacije o dostupnosti, kompatibilnosti delova ili poručivanju, kontaktirajte nas putem Vibera ili WhatsApp-a.
      </p>
    </div>

    <div class="contact-card">
      <h2>Glavni kontakt</h2>
      <p>Najbrži način da dobijete odgovor je da nam pošaljete <strong>broj dela (OE broj)</strong> i model vašeg vozila u poruci.</p>
      
      <div class="contact-methods">
        <a href="viber://chat?number=%2B381665040583" class="btn viber-btn">
          Viber (+381 66 504 0583)
        </a>
        <a href="https://wa.me/381665040583" class="btn whatsapp-btn">
          WhatsApp (+381 66 504 0583)
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .page-content {
    padding: 24px;
    max-width: 800px;
  }

  .content-header {
    margin-bottom: 32px;
    border-bottom: 2px solid var(--black);
    padding-bottom: 16px;
  }

  .page-title {
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: var(--black);
  }

  .page-description {
    font-size: 16px;
    color: #444;
    margin: 0;
  }

  .contact-card {
    background: var(--white);
    border: var(--border);
    padding: 24px;
    margin-bottom: 24px;
  }

  .contact-card h2 {
    margin-top: 0;
    font-size: 20px;
    border-bottom: 1px solid var(--gray-200);
    padding-bottom: 8px;
    margin-bottom: 16px;
  }

  .contact-methods {
    display: flex;
    gap: 16px;
    margin-top: 24px;
  }

  .contact-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .detail-block {
    background: var(--white);
    border: var(--border);
    padding: 20px;
  }

  .detail-block h3 {
    margin-top: 0;
    font-size: 16px;
    border-bottom: 1px solid var(--gray-200);
    padding-bottom: 8px;
    margin-bottom: 12px;
  }

  .detail-block ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .detail-block li, .detail-block p {
    font-size: 14px;
    margin-bottom: 8px;
    color: #333;
  }

  .note {
    margin-top: 16px;
    font-size: 13px !important;
    color: #c00;
    font-style: italic;
  }

  @media (max-width: 600px) {
    .contact-methods {
      flex-direction: column;
    }
    .contact-details {
      grid-template-columns: 1fr;
    }
  }
</style>
