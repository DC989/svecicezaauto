---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Pretraga | Svecicezaauto" description="Pretraga delova">
  <div class="body-layout">
    <main class="catalog-content">
      <h1 class="catalog-title">Rezultati pretrage</h1>
      <p id="search-status">Učitavanje rezultata...</p>
      
      <div id="search-results" class="search-results-list"></div>
    </main>
  </div>

  <style>
    .search-results-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 16px;
    }
    .search-result-item {
      display: flex;
      flex-direction: column;
      padding: 12px;
      border: var(--border);
      border-radius: 4px;
      background: var(--white);
      transition: border-color 0.15s;
    }
    .search-result-item:hover {
      border-color: var(--blue);
      text-decoration: none;
    }
    .search-result-item__pn {
      font-size: var(--text-lg);
      font-weight: 600;
      color: var(--black);
    }
    .search-result-item:hover .search-result-item__pn {
      color: var(--blue);
    }
    .search-result-item__cat {
      font-size: var(--text-xs);
      color: var(--gray-400);
      text-transform: uppercase;
      margin-top: 4px;
    }
  </style>

  <script>
    const CATEGORY_NAMES = {
      'modul-paljenja': 'Modul paljenja',
      'kontrolna-jedinica': 'Kontrolna jedinica',
      'kalem-za-paljenje-bobina': 'Kalem za paljenje-Bobina',
      'razvodnik-paljenja': 'Razvodnik paljenja',
      'svecice': 'Svećice',
      'pogon-razvodnika-paljenja': 'Pogon razvodnika paljenja',
      'kablovi-za-paljenje-delovi': 'Kablovi za paljenje-Delovi',
      'otpornik': 'Otpornik',
    };

    async function performSearch() {
      const urlParams = new URLSearchParams(window.location.search);
      const query = urlParams.get('q');
      const statusEl = document.getElementById('search-status');
      const resultsEl = document.getElementById('search-results');
      
      if (!query || query.trim() === '') {
        if(statusEl) statusEl.textContent = 'Unesite pojam za pretragu.';
        return;
      }
      
      const queryLower = query.toLowerCase().trim();
      
      try {
        const res = await fetch('/search-index.json');
        if (!res.ok) throw new Error('Network response was not ok');
        const index = await res.json();
        
        const results = index.filter((item: any) => {
          return item.part_number.toLowerCase().includes(queryLower);
        });
        
        if (results.length === 0) {
          if(statusEl) statusEl.textContent = `Nema rezultata za "${query}".`;
        } else {
          if(statusEl) statusEl.textContent = `Pronađeno ${results.length} rezultata za "${query}".`;
          
          if(resultsEl) {
            resultsEl.innerHTML = results.map((item: any) => `
              <a href="/proizvod/${item.id}" class="search-result-item">
                <span class="search-result-item__pn">${item.part_number}</span>
                <span class="search-result-item__cat">${CATEGORY_NAMES[item.category as keyof typeof CATEGORY_NAMES] || item.category}</span>
              </a>
            `).join('');
          }
        }
      } catch (err) {
        console.error('Search error', err);
        if(statusEl) statusEl.textContent = 'Greška pri pretrazi.';
      }
    }
    
    performSearch();
  </script>
</BaseLayout>
