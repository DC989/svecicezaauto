---
import CategoryPage from '../../../../components/pages/CategoryPage.astro';
import { CATEGORY_MAP, getProductsByCategorySlug } from '../../../../utils/products';

export async function getStaticPaths({ paginate }) {
  const slugs = Array.from(new Set(Object.values(CATEGORY_MAP)));
  return slugs.flatMap((slug) => {
    const products = getProductsByCategorySlug(slug);
    return paginate(products, {
      params: { id: slug },
      pageSize: 48,
    });
  });
}

const { page } = Astro.props;
const { id } = Astro.params;
---
<CategoryPage page={page} id={id} />
