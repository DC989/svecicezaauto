---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORY_MAP, CATEGORY_NAMES, getAllProducts } from '../../utils/products';

export async function getStaticPaths() {
  const products = getAllProducts();
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const categorySlug = CATEGORY_MAP[product.category];
const categoryName = CATEGORY_NAMES[categorySlug] || product.category;
---
<BaseLayout title={`${product.part_number} | Svecicezaauto`} description={product.description || `Kupi ${product.part_number} online.`}>
  <div class="body-layout">
    <main class="catalog-content">
      <div class="breadcrumb">
        <a href="/">Početna</a> / <a href={`/kategorija/${categorySlug}`}>{categoryName}</a> / <span>{product.part_number}</span>
      </div>
      
      <div class="product-detail">
        <div class="product-detail__main">
          <div class="product-detail__gallery">
            <div class="product-detail__img-main">
              {product.images && product.images[0] ? (
                <img src={`/${product.images[0].replace('images/', 'images/products/')}`} alt={product.part_number} loading="eager" />
              ) : (
                <div class="product-placeholder">Slika nije dostupna</div>
              )}
            </div>

          </div>
          
          <div class="product-detail__info">
            <h1 class="product-detail__pn">{product.part_number}</h1>
            <div class="product-detail__cat">{categoryName}</div>
            
            <div class="product-detail__price-action-wrapper">
              <div class="product-detail__actions">
                <h4>Proverite cenu i dostupnost:</h4>
                <div class="product-detail__action-buttons">
                  <a href={`viber://chat?number=%2B381665040583&text=Poštovani,%20interesuje%20me%20deo%20${product.part_number}`} class="btn-action btn-viber" target="_blank" rel="noopener noreferrer">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> Viber
                  </a>
                  <a href={`https://wa.me/381665040583?text=Poštovani,%20interesuje%20me%20deo%20${product.part_number}`} class="btn-action btn-whatsapp" target="_blank" rel="noopener noreferrer">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg> WhatsApp
                  </a>
                </div>
              </div>
            </div>
            
            {product.description && (
              <div class="product-detail__desc">{product.description}</div>
            )}
            
            <div class="product-detail__meta">
              <div>Broj dela: <span>{product.part_number}</span></div>
              {product.images && product.images.length > 1 && (
                <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
                  Proizvođač:
                  {product.images.slice(1).map(img => (
                    <div style="height: 32px; display: flex; align-items: center;">
                      <img src={`/${img.replace('images/', 'images/products/')}`} alt="Brand logo" style="max-height: 100%; max-width: 120px; object-fit: contain;" />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>

        <div class="product-detail__vehicles">
          <h3>Odgovara za vozila</h3>
          {product.vehicles && product.vehicles.length > 0 ? (
            <table class="vehicles-table">
              <thead>
                <tr>
                  <th>Marka</th>
                  <th>Modeli</th>
                  <th>Motor</th>
                  <th>Godište</th>
                </tr>
              </thead>
              <tbody>
                {product.vehicles.map(v => (
                  <tr>
                    <td>{v.make}</td>
                    <td>{v.models.join(', ')}</td>
                    <td>{v.engine_range || '-'}</td>
                    <td>
                      {v.year_from ? `${v.year_from}.` : ''} 
                      {v.year_to ? `- ${v.year_to}.` : (v.year_from ? '-' : '-')}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p style="color: var(--gray-400); font-style: italic; margin-top: 12px; font-size: var(--text-sm);">
              Nema dostupnih podataka o kompatibilnim vozilima.
            </p>
          )}
          <p style="margin-top: 16px; font-size: var(--text-sm); color: var(--gray-400); background: var(--gray-100); padding: 12px; border-radius: 4px; border-left: 3px solid #d32f2f;">
            <strong>Napomena:</strong> Podaci o kompatibilnosti vozila prikazani iznad su isključivo informativnog karaktera i možda nisu potpuni. Za precizne informacije i proveru da li ovaj deo odgovara vašem vozilu, molimo vas da nas kontaktirate putem Vibera ili WhatsApp-a.
          </p>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
