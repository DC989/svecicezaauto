  </div>
</div>
<header class="site-header" role="banner">
  <a href={import.meta.env.BASE_URL} class="site-logo" aria-label="Svecicezaauto — Početna">
    SVECICEZAAUTO
  </a>
  <form class="search-form" role="search" action={`${import.meta.env.BASE_URL}search`} method="get" toolname="search_parts" tooldescription="Pretraga baze auto delova po broju dela">
    <label for="part-search" class="visually-hidden">Pretraga delova</label>
    <div class="search-input-wrap">
      <input
        id="part-search"
        name="q"
        type="search"
        class="search-input"
        placeholder="Pretraga po broju dela"
        autocomplete="off"
        spellcheck="false"
        description="Broj auto dela za koji želite da pretražite dostupnost (na primer: 19571035)"
      />
      <button class="search-btn" type="submit" aria-label="Pretraga">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5"/>
          <line x1="13" y1="13" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </form>
</header>
