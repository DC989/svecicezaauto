---
import { useTranslations, getLangFromUrl, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---
<div class="util-bar" role="banner" style="background: #f8fafc; padding: 10px 16px; border-bottom: 1px solid #e2e8f0;">
  <div class="top-banner-content" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 12px; max-width: 1200px; margin: 0 auto;">
    
    <div style="display: flex; align-items: center; gap: 8px; font-weight: 600; color: #0f172a; font-size: 14px;">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
        <line x1="12" y1="22.08" x2="12" y2="12"></line>
      </svg>
      {t('header.banner')}
    </div>

    <div class="banner-actions" style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
      <span style="color: #64748b; font-weight: 500; font-size: 13px;">{t('header.check')}</span>
      <div style="display: flex; gap: 12px;">
        <a href="viber://chat?number=%2B381665040583" aria-label="Viber kontakt" style="display: flex; align-items: center; gap: 4px; color: #7360f2; font-weight: 600; text-decoration: none; font-size: 14px;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> Viber
        </a>
        <a href="https://wa.me/381665040583?text=Poštovani,%20imam%20pitanje%20u%20vezi%20delova." aria-label="WhatsApp kontakt" target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; gap: 4px; color: #25d366; font-weight: 600; text-decoration: none; font-size: 14px;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg> WhatsApp
        </a>
      </div>
      <div class="lang-switcher" style="display: flex; gap: 8px; margin-left: 8px; border-left: 1px solid #cbd5e1; padding-left: 16px;">
        <a href={translatePath('/', 'sr')} style={`font-size: 12px; font-weight: 600; text-decoration: none; color: ${lang === 'sr' ? '#2563eb' : '#64748b'}`}>SR</a>
        <a href={translatePath('/', 'ru')} style={`font-size: 12px; font-weight: 600; text-decoration: none; color: ${lang === 'ru' ? '#2563eb' : '#64748b'}`}>RU</a>
      </div>
    </div>
  </div>
</div>

<style>
  @media (max-width: 640px) {
    .top-banner-content {
      justify-content: center !important;
      text-align: center;
    }
    .banner-actions {
      justify-content: center;
      width: 100%;
    }
  }
</style>
<header class="site-header" role="banner">
  <a href={translatePath('/')} class="site-logo" aria-label="Svecicezaauto — Početna">
    SVECICEZAAUTO
  </a>
  <form class="search-form" role="search" action={translatePath('/search')} method="get" toolname="search_parts" tooldescription="Pretraga baze auto delova po broju dela">
    <label for="part-search" class="visually-hidden">Pretraga delova</label>
    <div class="search-input-wrap">
      <input
        id="part-search"
        name="q"
        type="search"
        class="search-input"
        placeholder={t('header.searchPlaceholder')}
        autocomplete="off"
        spellcheck="false"
        description="Broj auto dela za koji želite da pretražite dostupnost (na primer: 19571035)"
      />
      <button class="search-btn" type="submit" aria-label="Pretraga">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5"/>
          <line x1="13" y1="13" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </form>
</header>
