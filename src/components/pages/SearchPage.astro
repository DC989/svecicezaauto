---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getLangFromUrl, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const uiStrings = {
  empty: t('search.empty'),
  noResults: t('search.noResults'),
  found: t('search.found'),
  for: t('search.for'),
  error: t('search.error'),
};

const categoryNames = {
  'modul-paljenja': t('cat.modul-paljenja'),
  'kontrolna-jedinica': t('cat.kontrolna-jedinica'),
  'kalem-za-paljenje-bobina': t('cat.kalem-za-paljenje-bobina'),
  'razvodnik-paljenja': t('cat.razvodnik-paljenja'),
  'svecice': t('cat.svecice'),
  'pogon-razvodnika-paljenja': t('cat.pogon-razvodnika-paljenja'),
  'kablovi-za-paljenje-delovi': t('cat.kablovi-za-paljenje-delovi'),
  'otpornik': t('cat.otpornik'),
};
---
<BaseLayout title={`${t('search.title')} | Svecicezaauto`} description="Pretraga delova">
  <div class="body-layout">
    <main class="catalog-content">
      <h1 class="catalog-title">{t('search.heading')}</h1>
      <p id="search-status" data-strings={JSON.stringify(uiStrings)} data-cats={JSON.stringify(categoryNames)} data-base={translatePath('/')}>{t('search.loading')}</p>
      
      <div id="search-results" class="search-results-list"></div>
    </main>
  </div>

  <style>
    .search-results-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 16px;
    }
    .search-result-item {
      display: flex;
      flex-direction: column;
      padding: 12px;
      border: var(--border);
      border-radius: 4px;
      background: var(--white);
      transition: border-color 0.15s;
    }
    .search-result-item:hover {
      border-color: var(--blue);
      text-decoration: none;
    }
    .search-result-item__pn {
      font-size: var(--text-lg);
      font-weight: 600;
      color: var(--black);
    }
    .search-result-item:hover .search-result-item__pn {
      color: var(--blue);
    }
    .search-result-item__cat {
      font-size: var(--text-xs);
      color: var(--gray-400);
      text-transform: uppercase;
      margin-top: 4px;
    }
  </style>

  <script>
    async function performSearch() {
      const BASE_URL = import.meta.env.BASE_URL;
      const urlParams = new URLSearchParams(window.location.search);
      const query = urlParams.get('q');
      const statusEl = document.getElementById('search-status');
      const resultsEl = document.getElementById('search-results');
      
      if (!statusEl) return;
      
      const uiStrings = JSON.parse(statusEl.dataset.strings || '{}');
      const categoryNames = JSON.parse(statusEl.dataset.cats || '{}');
      const routeBase = statusEl.dataset.base || BASE_URL;

      if (!query || query.trim() === '') {
        if(statusEl) statusEl.textContent = uiStrings.empty;
        return;
      }
      
      const queryLower = query.toLowerCase().trim();
      
      try {
        const res = await fetch(`${BASE_URL}search-index.json`);
        if (!res.ok) throw new Error('Network response was not ok');
        const index = await res.json();
        
        const results = index.filter((item: any) => {
          return item.part_number.toLowerCase().includes(queryLower);
        });
        
        if (results.length === 0) {
          if(statusEl) statusEl.textContent = `${uiStrings.noResults} "${query}".`;
        } else {
          if(statusEl) statusEl.textContent = `${uiStrings.found} ${results.length} ${uiStrings.for} "${query}".`;
          
          if(resultsEl) {
            resultsEl.innerHTML = results.map((item: any) => `
              <a href="${routeBase}proizvod/${item.id}" class="search-result-item">
                <span class="search-result-item__pn">${item.part_number}</span>
                <span class="search-result-item__cat">${categoryNames[item.category] || item.category}</span>
              </a>
            `).join('');
          }
        }
      } catch (err) {
        console.error('Search error', err);
        if(statusEl) statusEl.textContent = uiStrings.error;
      }
    }
    
    performSearch();
  </script>
</BaseLayout>
